        customTerms = customTerms.filter(x=>x.id!==t.id);
        delete progress[t.id];
        saveProgress(progress);
        saveTerms(); buildDeck(); renderManage(); renderFolderChips();
      };
      row.appendChild(delBtn);
      wordList.appendChild(row);
    });
  }

  const exportBtn = document.getElementById('exportBtn');
  if(exportBtn){
    exportBtn.onclick = ()=>{
      let csv = '영어,약어,뜻\n';
      folderTerms.forEach(t=>{ csv += csvEscape(t.en)+','+csvEscape(t.abbr)+','+csvEscape(t.ko)+'\n'; });
      downloadBlob(csv, (af.name||'단어장')+'.csv');
    };
  }
  const clearAllBtn = document.getElementById('clearAllBtn');
  if(clearAllBtn){
    let armed = false, timer = null;
    clearAllBtn.onclick = ()=>{
      if(!armed){
        armed = true;
        clearAllBtn.textContent = '정말 이 폴더 단어를 전부 삭제할까요? 한 번 더 눌러 확인';
        clearAllBtn.style.background = 'var(--terracotta-tint)';
        clearTimeout(timer);
        timer = setTimeout(()=>{ armed=false; clearAllBtn.textContent='이 폴더 단어 전체 삭제'; clearAllBtn.style.background='transparent'; }, 3000);
        return;
      }
      clearTimeout(timer);
      const ids = customTerms.filter(t=>t.folderId===currentFolderId).map(t=>t.id);
      customTerms = customTerms.filter(t=>t.folderId!==currentFolderId);
      ids.forEach(tid=>{ delete progress[tid]; });
      saveProgress(progress);
      saveTerms(); buildDeck(); renderManage(); renderFolderChips();
    };
  }
}

// ---------- shared ----------
function escapeHtml(s){
  return String(s).replace(/[&<>"']/g, m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
}
function render(){
  renderFolderChips();
  const af = activeFolder();
  document.getElementById('subtitle').textContent = af ? (af.name + ' · ' + currentTerms().length + ' WORDS') : (folders.length===0 ? '폴더를 만들어보세요' : '폴더를 선택하세요');
  if(state.mode==='flash') renderFlash();
  else if(state.mode==='quiz') renderQuiz(false);
  else if(state.mode==='spell') renderSpell(false);
  else if(state.mode==='stats') renderStats();
  else if(state.mode==='manage') renderManage();
}
document.querySelectorAll('nav.bottom button').forEach(btn=>{
  btn.onclick = ()=>{
    document.querySelectorAll('nav.bottom button').forEach(b=>b.classList.remove('active'));
    btn.classList.add('active');
    state.mode = btn.dataset.mode;
    render();
  };
});

buildDeck();
render();

// ---------- PWA: service worker registration ----------
if('serviceWorker' in navigator){
  window.addEventListener('load', ()=>{
    navigator.serviceWorker.register('./service-worker.js').catch(()=>{});
  });
}
</script>
</body>
</html>
