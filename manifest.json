<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>나만의 단어장</title>

<!-- PWA -->
<link rel="manifest" href="./manifest.json">
<meta name="theme-color" content="#3C5B49">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="단어장">
<link rel="apple-touch-icon" href="./icons/icon-192.png">
<link rel="icon" type="image/png" sizes="192x192" href="./icons/icon-192.png">
<link rel="icon" type="image/png" sizes="512x512" href="./icons/icon-512.png">

<style>
  :root{
    --bg1:#FBF6EF; --bg2:#F3E9DC; --paper:#FFFFFF; --ink:#2E332E; --ink-soft:#6E6A61;
    --forest:#3C5B49; --forest-deep:#2A4234; --forest-tint:#E4EDE4;
    --terracotta:#C97B5F; --terracotta-tint:#F6E6DE;
    --gold:#C99A3E; --gold-tint:#F6EEDA; --line:#E7DED0;
    --sans: -apple-system, BlinkMacSystemFont, "Apple SD Gothic Neo", "Malgun Gothic", "Segoe UI", Roboto, sans-serif;
  }
  *{box-sizing:border-box; -webkit-tap-highlight-color:transparent;}
  html,body{margin:0;padding:0;height:100%;font-family:var(--sans);color:var(--ink);}
  body{background:linear-gradient(180deg,var(--bg1),var(--bg2) 60%);}
  #app{display:flex;flex-direction:column;height:100vh;height:100dvh;max-width:560px;margin:0 auto;position:relative;}

  header.top{padding:22px 22px 6px;flex-shrink:0;display:flex;align-items:center;gap:12px;}
  .logo{width:38px;height:38px;border-radius:12px;background:var(--forest);display:flex;align-items:center;justify-content:center;flex-shrink:0;box-shadow:0 4px 10px rgba(60,91,73,.25);}
  header.top h1{margin:0;font-size:17px;font-weight:700;letter-spacing:-.2px;color:var(--forest-deep);}
  header.top p{margin:2px 0 0;font-size:11.5px;color:var(--ink-soft);letter-spacing:.3px;}

  #folderChips{display:flex;gap:7px;padding:4px 22px 14px;flex-shrink:0;overflow-x:auto;}
  .chip{flex-shrink:0;padding:8px 14px;border-radius:20px;border:1px solid transparent;background:var(--paper);color:var(--ink-soft);font-size:12.5px;font-weight:600;cursor:pointer;box-shadow:0 1px 3px rgba(60,50,30,.06);}
  .chip.active{background:var(--forest);color:#fff;box-shadow:0 3px 8px rgba(60,91,73,.28);}

  main{flex:1;overflow-y:auto;padding:14px 22px 20px;display:flex;flex-direction:column;}

  .pearlRow{display:flex;align-items:center;justify-content:center;gap:6px;margin:2px 0 16px;}
  .pearl{width:7px;height:7px;border-radius:50%;background:var(--line);transition:.25s;}
  .pearl.on{background:var(--gold);box-shadow:0 0 0 3px var(--gold-tint);}
  .streakLabel{font-size:11px;color:var(--ink-soft);margin-left:6px;font-weight:600;}

  #cardStage{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:280px;}
  .progressRow{width:100%;display:flex;justify-content:space-between;align-items:center;font-size:12px;color:var(--ink-soft);margin-bottom:10px;font-weight:600;}
  .progressBar{flex:1;height:4px;background:var(--line);margin:0 10px;border-radius:3px;overflow:hidden;}
  .progressBar i{display:block;height:100%;background:var(--forest);width:0%;transition:width .3s;border-radius:3px;}

  .flipZone{width:100%;max-width:420px;min-height:250px;perspective:1400px;}
  .card{position:relative;width:100%;height:250px;cursor:pointer;transform-style:preserve-3d;transition:transform .5s cubic-bezier(.4,.2,.2,1);}
  .card.flipped{transform:rotateY(180deg);}
  .face{position:absolute;inset:0;backface-visibility:hidden;background:var(--paper);border:1px solid var(--line);border-radius:26px;padding:26px 24px;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;box-shadow:0 10px 28px rgba(60,50,30,.10);}
  .face .idTag{position:absolute;top:16px;right:18px;font-size:10.5px;color:var(--ink-soft);font-weight:600;}
  .face.back{transform:rotateY(180deg);background:var(--forest-tint);border-color:#D4E0D3;}
  .abbrBadge{font-size:12.5px;font-weight:700;color:var(--forest);background:#fff;border:1px solid #CFE0CE;padding:4px 12px;border-radius:9px;margin-bottom:14px;letter-spacing:.4px;}
  .mainWord{font-size:22px;font-weight:700;line-height:1.4;word-break:keep-all;color:var(--forest-deep);}
  .koWord{font-size:20px;font-weight:700;line-height:1.45;word-break:keep-all;color:var(--ink);}
  .hint{position:absolute;bottom:14px;font-size:10.5px;color:var(--ink-soft);letter-spacing:.3px;}

  .speakBtn{
    display:inline-flex;align-items:center;justify-content:center;gap:6px;
    margin-top:14px;padding:9px 16px;border-radius:20px;border:1.5px solid #CFE0CE;
    background:#fff;color:var(--forest);font-size:13px;font-weight:700;
    font-family:var(--sans);cursor:pointer;
  }
  .speakBtn:active{transform:scale(.96);}
  .speakBtn svg{width:15px;height:15px;flex-shrink:0;}
  .speakBtn.playing{background:var(--forest);color:#fff;border-color:var(--forest);}

  .cardActions{display:flex;gap:10px;width:100%;max-width:420px;margin-top:16px;}
  .btn{flex:1;padding:14px 10px;border-radius:14px;border:1.5px solid var(--line);background:var(--paper);color:var(--ink);font-size:14.5px;font-weight:700;cursor:pointer;font-family:var(--sans);}
  .btn:active{transform:scale(.97);}
  .btn.ghost{background:transparent;border-color:transparent;color:var(--ink-soft);flex:0 0 auto;padding:13px 16px;}
  .btn.no{border-color:#E7C9BC;color:var(--terracotta);background:var(--terracotta-tint);}
  .btn.yes{border-color:#BFD8BE;color:var(--forest);background:var(--forest-tint);}
  .btn.big{background:var(--forest);color:#fff;border:none;box-shadow:0 4px 12px rgba(60,91,73,.25);}

  .qHead{font-size:12px;color:var(--ink-soft);font-weight:700;letter-spacing:.2px;margin-bottom:10px;}
  .qPrompt{background:var(--paper);border:1px solid var(--line);border-radius:22px;padding:26px 20px;text-align:center;font-size:19px;font-weight:700;margin-bottom:16px;word-break:keep-all;line-height:1.45;color:var(--forest-deep);box-shadow:0 8px 22px rgba(60,50,30,.08);}
  .qPrompt .abbrBadge{margin-bottom:12px;}
  .opts{display:flex;flex-direction:column;gap:9px;}
  .opt{padding:15px 17px;border-radius:14px;border:1.5px solid var(--line);background:var(--paper);color:var(--ink);font-size:14.5px;font-weight:600;text-align:left;cursor:pointer;font-family:var(--sans);word-break:keep-all;}
  .opt:active{transform:scale(.985);}
  .opt.correct{border-color:var(--forest);background:var(--forest-tint);color:var(--forest-deep);}
  .opt.wrong{border-color:var(--terracotta);background:var(--terracotta-tint);color:var(--terracotta);}
  .opt[disabled]{pointer-events:none;}
  #quizNext{margin-top:16px;}

  .spellPrompt{background:var(--paper);border:1px solid var(--line);border-radius:22px;padding:26px 20px;text-align:center;margin-bottom:16px;box-shadow:0 8px 22px rgba(60,50,30,.08);}
  .spellPrompt .ko{font-size:19px;font-weight:700;word-break:keep-all;line-height:1.45;color:var(--forest-deep);}
  .spellPrompt .abbrBadge{margin-top:12px;margin-bottom:0;}
  #spellInput{width:100%;padding:15px 17px;border-radius:14px;border:1.5px solid var(--line);background:var(--paper);color:var(--ink);font-size:16px;font-family:var(--sans);outline:none;font-weight:600;}
  #spellInput:focus{border-color:var(--forest);}
  #spellInput.correct{border-color:var(--forest);color:var(--forest);background:var(--forest-tint);}
  #spellInput.wrong{border-color:var(--terracotta);color:var(--terracotta);background:var(--terracotta-tint);}
  .spellRow{display:flex;gap:10px;margin-top:12px;}
  #spellFeedback{margin-top:12px;font-size:13.5px;font-weight:700;min-height:18px;text-align:center;}
  #spellFeedback.correct{color:var(--forest);}
  #spellFeedback.wrong{color:var(--terracotta);}

  .statGrid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:18px;}
  .statBox{background:var(--paper);border:1px solid var(--line);border-radius:18px;padding:16px;box-shadow:0 6px 16px rgba(60,50,30,.06);}
  .statBox .num{font-size:26px;font-weight:800;color:var(--forest);}
  .statBox .lbl{font-size:11.5px;color:var(--ink-soft);margin-top:3px;font-weight:600;}
  .missList{background:var(--paper);border:1px solid var(--line);border-radius:18px;padding:4px 0;box-shadow:0 6px 16px rgba(60,50,30,.06);}
  .missRow{display:flex;justify-content:space-between;align-items:center;padding:13px 18px;border-bottom:1px solid var(--line);font-size:13.5px;}
  .missRow:last-child{border-bottom:none;}
  .missRow .en{font-weight:700;color:var(--ink);}
  .missRow .ko{color:var(--ink-soft);font-size:12px;margin-top:2px;}
  .missRow .badge{font-size:11px;font-weight:700;color:var(--terracotta);background:var(--terracotta-tint);padding:3px 9px;border-radius:9px;flex-shrink:0;margin-left:8px;}
  .delBtn{border:none;background:var(--terracotta-tint);color:var(--terracotta);width:28px;height:28px;border-radius:9px;font-weight:700;cursor:pointer;flex-shrink:0;margin-left:8px;font-size:14px;}
  .emptyMsg{text-align:center;color:var(--ink-soft);font-size:13.5px;padding:36px 10px;font-weight:600;line-height:1.6;}
  #resetBtn, #clearAllBtn{width:100%;margin-top:16px;padding:14px;border-radius:14px;border:1.5px solid #E7C9BC;background:transparent;color:var(--terracotta);font-size:13.5px;font-weight:700;font-family:var(--sans);cursor:pointer;}

  .manageCard{background:var(--paper);border:1px solid var(--line);border-radius:18px;padding:16px;margin-bottom:18px;box-shadow:0 6px 16px rgba(60,50,30,.06);}
  .manageCard input, .manageCard textarea{width:100%;padding:12px 14px;border-radius:12px;border:1.5px solid var(--line);margin-bottom:8px;font-family:var(--sans);font-size:14px;background:var(--bg1);color:var(--ink);outline:none;resize:vertical;}
  .manageCard input:focus, .manageCard textarea:focus{border-color:var(--forest);}
  .mgDesc{font-size:12px;color:var(--ink-soft);margin:0 0 10px;line-height:1.55;}
  .mgRow{display:flex;gap:8px;}
  .mgRow .btn{padding:12px 8px;font-size:13px;}
  .mgStatus{font-size:12.5px;color:var(--forest);font-weight:700;margin-top:10px;min-height:16px;}

  /* ---- folder list (manage tab) ---- */
  .folderList{display:flex;flex-direction:column;gap:8px;margin-top:2px;}
  .folderRow{display:flex;align-items:center;justify-content:space-between;padding:12px 14px;border-radius:14px;border:1.5px solid var(--line);background:var(--bg1);cursor:pointer;}
  .folderRow.active{border-color:var(--forest);background:var(--forest-tint);}
  .folderInfo{flex:1;min-width:0;}
  .folderName{font-weight:700;font-size:14px;color:var(--ink);word-break:break-all;}
  .folderCount{font-size:11.5px;color:var(--ink-soft);margin-top:2px;font-weight:600;}
  .folderRow.active .folderCount{color:var(--forest);}
  .folderActions{display:flex;gap:6px;flex-shrink:0;margin-left:8px;}
  .iconBtn{border:1px solid var(--line);background:#fff;color:var(--ink-soft);width:30px;height:30px;border-radius:9px;font-size:13px;cursor:pointer;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
  .iconBtn:active{transform:scale(.94);}
  .iconBtn.danger{color:var(--terracotta);}
  .renameInput{flex:1;padding:6px 8px;border-radius:8px;border:1.5px solid var(--forest);font-family:var(--sans);font-size:14px;outline:none;background:#fff;}

  nav.bottom{display:flex;gap:3px;background:var(--paper);flex-shrink:0;padding:9px 8px calc(9px + env(safe-area-inset-bottom));margin:0 12px 12px;border-radius:22px;box-shadow:0 10px 26px rgba(60,50,30,.14);}
  nav.bottom button{flex:1;background:none;border:none;color:var(--ink-soft);padding:8px 2px 6px;font-size:10px;font-weight:700;font-family:var(--sans);display:flex;flex-direction:column;align-items:center;gap:4px;cursor:pointer;border-radius:14px;}
  nav.bottom button.active{color:var(--forest);background:var(--forest-tint);}
  nav.bottom svg{width:19px;height:19px;}

  ::-webkit-scrollbar{display:none;}
</style>
</head>
<body>
<div id="app">
  <header class="top">
    <div class="logo">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z"/>
      </svg>
    </div>
    <div>
      <h1>나만의 단어장</h1>
      <p id="subtitle">0 WORDS</p>
    </div>
  </header>

  <div id="folderChips"></div>

  <main id="main"></main>

  <nav class="bottom">
    <button data-mode="flash" class="active">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="3"/><path d="M7 10h6M7 14h3"/></svg>
      카드
    </button>
    <button data-mode="quiz">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="m8.5 12.5 2.3 2.3L15.5 9.5"/></svg>
      객관식
    </button>
    <button data-mode="spell">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
      스펠링
    </button>
    <button data-mode="stats">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20V10M12 20V4M20 20v-7"/></svg>
      기록
    </button>
    <button data-mode="manage">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v8M8 12h8"/></svg>
      단어장
    </button>
  </nav>
</div>

<script>
const FOLDERS_KEY = 'customwords_folders_v1';
const NEXT_FOLDERID_KEY = 'customwords_nextfolderid_v1';
const CURRENT_FOLDER_KEY = 'customwords_currentfolder_v1';
const TERMS_KEY = 'customwords_terms_v1';
const NEXTID_KEY = 'customwords_nextid_v1';
const STORE_KEY = 'customwords_progress_v1';
const MODES = ['flash','quiz','spell'];
const MODE_LABEL = {flash:'플래시카드', quiz:'객관식', spell:'스펠링'};

// ---------- folders ----------
function loadFolders(){
  try{ const raw = localStorage.getItem(FOLDERS_KEY); return raw ? JSON.parse(raw) : []; }catch(e){ return []; }
}
function saveFolders(){ try{ localStorage.setItem(FOLDERS_KEY, JSON.stringify(folders)); }catch(e){} }
let folders = loadFolders();
let nextFolderId = parseInt(localStorage.getItem(NEXT_FOLDERID_KEY)||'1',10);
function newFolderId(){ const id = nextFolderId++; localStorage.setItem(NEXT_FOLDERID_KEY, String(nextFolderId)); return id; }

// ---------- terms ----------
function loadTerms(){
  try{ const raw = localStorage.getItem(TERMS_KEY); return raw ? JSON.parse(raw) : []; }catch(e){ return []; }
}
function saveTerms(){ try{ localStorage.setItem(TERMS_KEY, JSON.stringify(customTerms)); }catch(e){} }
let customTerms = loadTerms();

let nextId = parseInt(localStorage.getItem(NEXTID_KEY)||'1',10);
function newId(){ const id = nextId++; localStorage.setItem(NEXTID_KEY, String(nextId)); return id; }

// ---------- migration: old (folder-less) words -> "기본 단어장" folder ----------
(function migrate(){
  const orphans = customTerms.filter(t => !t.folderId);
  if(orphans.length > 0){
    let def = folders.find(f => f.name === '기본 단어장');
    if(!def){
      def = { id: newFolderId(), name: '기본 단어장' };
      folders.push(def);
      saveFolders();
    }
    orphans.forEach(t => { t.folderId = def.id; });
    saveTerms();
  }
})();

let currentFolderId = parseInt(localStorage.getItem(CURRENT_FOLDER_KEY)||'',10);
if(!folders.some(f=>f.id===currentFolderId)){
  currentFolderId = folders.length>0 ? folders[0].id : null;
  if(currentFolderId) localStorage.setItem(CURRENT_FOLDER_KEY, String(currentFolderId));
}

// ---------- progress ----------
function loadProgress(){
  try{ const raw = localStorage.getItem(STORE_KEY); return raw ? JSON.parse(raw) : {}; }catch(e){ return {}; }
}
function saveProgress(p){ try{ localStorage.setItem(STORE_KEY, JSON.stringify(p)); }catch(e){} }
let progress = loadProgress();

function getStat(id, mode){
  if(!progress[id]) progress[id] = {};
  if(!progress[id][mode]) progress[id][mode] = {correct:0, wrong:0};
  return progress[id][mode];
}
function isMastered(id, mode){
  const s = getStat(id, mode);
  return s.correct >= 2 && s.correct > s.wrong;
}

let state = { mode:'flash', deck:[], idx:0, flipped:false, streak: parseInt(localStorage.getItem('customwords_streak_v1')||'0',10), quizAnswered:false };

function currentTerms(){
  if(!currentFolderId) return [];
  return customTerms.filter(t => t.folderId === currentFolderId);
}
function activeFolder(){ return folders.find(f=>f.id===currentFolderId) || null; }

function shuffle(arr){
  const a = arr.slice();
  for(let i=a.length-1;i>0;i--){ const j = Math.floor(Math.random()*(i+1)); [a[i],a[j]]=[a[j],a[i]]; }
  return a;
}
function buildDeck(){
  state.deck = shuffle(currentTerms());
  state.idx = 0;
  state.flipped = false;
  currentQ = null;
  spellTarget = null;
}

function bumpStreak(good){
  state.streak = good ? state.streak+1 : 0;
  localStorage.setItem('customwords_streak_v1', state.streak);
  renderPearls();
}
function renderPearls(){
  const el = document.getElementById('pearlRow');
  if(!el) return;
  const cap = 8;
  const filled = Math.min(state.streak, cap);
  let dots = '';
  for(let i=0;i<cap;i++) dots += `<span class="pearl ${i<filled?'on':''}"></span>`;
  el.innerHTML = dots + `<span class="streakLabel">연속 ${state.streak}</span>`;
}

function emptyStateHtml(){
  if(folders.length===0){
    return '폴더가 아직 없어요.<br>하단의 "단어장" 탭에서 폴더를 먼저 만들어보세요.';
  }
  if(!currentFolderId){
    return '위에서 폴더를 선택해주세요.';
  }
  return '이 폴더에는 아직 단어가 없어요.<br>"단어장" 탭에서 단어를 추가해보세요.';
}

// ---------- folder chips ----------
function renderFolderChips(){
  const wrap = document.getElementById('folderChips');
  if(!wrap) return;
  if(folders.length===0){ wrap.style.display='none'; wrap.innerHTML=''; return; }
  wrap.style.display='flex';
  wrap.innerHTML = '';
  folders.forEach(f=>{
    const chip = document.createElement('div');
    chip.className = 'chip' + (f.id===currentFolderId ? ' active' : '');
    chip.textContent = f.name;
    chip.onclick = ()=>{
      if(currentFolderId===f.id) return;
      currentFolderId = f.id;
      localStorage.setItem(CURRENT_FOLDER_KEY, String(currentFolderId));
      buildDeck();
      render();
    };
    wrap.appendChild(chip);
  });
}

// ---------- TTS (영어 발음 듣기) ----------
function speakEnglish(text, btnEl){
  if(!('speechSynthesis' in window)){
    if(btnEl){
      const label = btnEl.querySelector('.speakLabel');
      if(label) label.textContent = '이 브라우저는 음성 지원 안 함';
    }
    return;
  }
  window.speechSynthesis.cancel();
  const utter = new SpeechSynthesisUtterance(text);
  utter.lang = 'en-US';
  utter.rate = 0.9;
  if(btnEl){
    btnEl.classList.add('playing');
    utter.onend = ()=> btnEl.classList.remove('playing');
    utter.onerror = ()=> btnEl.classList.remove('playing');
  }
  window.speechSynthesis.speak(utter);
}

// ---------- FLASHCARD ----------
function renderFlash(){
  const main = document.getElementById('main');
  if(state.deck.length===0){
    main.innerHTML = `<div class="emptyMsg">${emptyStateHtml()}</div>`;
    return;
  }
  const t = state.deck[state.idx];
  const pct = Math.round(((state.idx)/state.deck.length)*100);
  main.innerHTML = `
    <div id="cardStage">
      <div class="progressRow">
        <span>${state.idx+1} / ${state.deck.length}</span>
        <div class="progressBar"><i style="width:${pct}%"></i></div>
        <span>${isMastered(t.id,'flash')?'✓ 완료':''}</span>
      </div>
      <div class="flipZone">
        <div class="card" id="flashCard">
          <div class="face front">
            <span class="idTag">#${t.id}</span>
            <div class="koWord">${escapeHtml(t.ko)}</div>
            <div class="hint">탭하여 뒤집기</div>
          </div>
          <div class="face back">
            <span class="idTag">#${t.id}</span>
            ${t.abbr?`<div class="abbrBadge">${escapeHtml(t.abbr)}</div>`:''}
            <div class="mainWord">${escapeHtml(t.en)}</div>
            <button class="speakBtn" id="speakBtn" type="button">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 5 6 9H3v6h3l5 4V5Z"/><path d="M15.5 8.5a5 5 0 0 1 0 7"/><path d="M18.5 6a9 9 0 0 1 0 12"/></svg>
              <span class="speakLabel">발음 듣기</span>
            </button>
            <div class="hint">탭하여 뒤집기</div>
          </div>
        </div>
      </div>
      <div class="pearlRow" id="pearlRow"></div>
      <div class="cardActions">
        <button class="btn no" id="btnNo">✗ 몰라요</button>
        <button class="btn yes" id="btnYes">✓ 알아요</button>
      </div>
    </div>
  `;
  renderPearls();
  const cardEl = document.getElementById('flashCard');
  cardEl.onclick = ()=>{ state.flipped = !state.flipped; cardEl.classList.toggle('flipped', state.flipped); };
  document.getElementById('btnYes').onclick = (e)=>{ e.stopPropagation(); markFlash(t.id, true); };
  document.getElementById('btnNo').onclick = (e)=>{ e.stopPropagation(); markFlash(t.id, false); };
  const speakBtn = document.getElementById('speakBtn');
  if(speakBtn){
    speakBtn.onclick = (e)=>{ e.stopPropagation(); speakEnglish(t.en, speakBtn); };
  }
}
function markFlash(id, correct){
  const s = getStat(id, 'flash');
  if(correct){ s.correct++; } else { s.wrong++; }
  saveProgress(progress);
  bumpStreak(correct);
  nextFlash();
}
function nextFlash(){
  state.flipped = false;
  state.idx++;
  if(state.idx >= state.deck.length){ state.deck = shuffle(currentTerms()); state.idx = 0; }
  renderFlash();
}

// ---------- QUIZ ----------
function makeQuizQuestion(){
  const pool = currentTerms();
  if(pool.length < 4){ return null; }
  const target = pool[Math.floor(Math.random()*pool.length)];
  const types = ['en2ko', 'ko2en'];
  const type = types[Math.floor(Math.random()*types.length)];
  let promptHtml, correctText, getOptionText;
  if(type==='en2ko'){
    promptHtml = `${target.abbr?`<div class="abbrBadge">${escapeHtml(target.abbr)}</div><br/>`:''}${escapeHtml(target.en)}`;
    correctText = target.ko; getOptionText = (t)=>t.ko;
  } else {
    promptHtml = escapeHtml(target.ko);
    correctText = target.en; getOptionText = (t)=>t.en;
  }
  let distractPool = pool.filter(t=>t.id!==target.id && getOptionText(t) !== correctText);
  distractPool = shuffle(distractPool).slice(0,3);
  while(distractPool.length<3){
    const extra = pool.filter(t=>t.id!==target.id && !distractPool.includes(t) && getOptionText(t)!==correctText);
    if(extra.length===0) break;
    distractPool.push(extra[Math.floor(Math.random()*extra.length)]);
  }
  const options = shuffle([{text:correctText, correct:true}, ...distractPool.map(t=>({text:getOptionText(t), correct:false}))]);
  return {target, promptHtml, options, type};
}
let currentQ = null;
function renderQuiz(fresh){
  const main = document.getElementById('main');
  if(fresh || !currentQ){ currentQ = makeQuizQuestion(); state.quizAnswered = false; }
  if(!currentQ){
    main.innerHTML = currentTerms().length<4 && folders.length>0 && currentFolderId
      ? '<div class="emptyMsg">객관식 문제를 내려면 이 폴더에 단어가 최소 4개 필요해요.</div>'
      : `<div class="emptyMsg">${emptyStateHtml()}</div>`;
    return;
  }
  const typeLabel = {en2ko:'영어 → 뜻을 고르세요', ko2en:'뜻 → 영어를 고르세요'}[currentQ.type];
  main.innerHTML = `
    <div class="pearlRow" id="pearlRow" style="justify-content:flex-start;margin-bottom:12px;"></div>
    <div class="qHead">${typeLabel}</div>
    <div class="qPrompt">${currentQ.promptHtml}</div>
    <div class="opts" id="optsWrap"></div>
    <button class="btn big" id="quizNext" style="display:none;">다음 문제 →</button>
  `;
  renderPearls();
  const optsWrap = document.getElementById('optsWrap');
  currentQ.options.forEach(o=>{
    const b = document.createElement('button');
    b.className = 'opt'; b.textContent = o.text;
    b.onclick = ()=>{
      if(state.quizAnswered) return;
      state.quizAnswered = true;
      const s = getStat(currentQ.target.id, 'quiz');
      if(o.correct){ s.correct++; } else { s.wrong++; }
      saveProgress(progress);
      bumpStreak(o.correct);
      [...optsWrap.children].forEach(el=>{
        el.disabled = true;
        if(el.textContent === currentQ.options.find(x=>x.correct).text) el.classList.add('correct');
      });
      if(!o.correct) b.classList.add('wrong');
      document.getElementById('quizNext').style.display = 'block';
    };
    optsWrap.appendChild(b);
  });
  document.getElementById('quizNext').onclick = ()=>renderQuiz(true);
}

// ---------- SPELLING ----------
let spellTarget = null;
let spellChecked = false;
function pickSpellTarget(){
  const pool = currentTerms();
  if(pool.length===0) return null;
  return pool[Math.floor(Math.random()*pool.length)];
}
function normalize(s){ return s.toLowerCase().replace(/[\s\-\/,()]/g,'').trim(); }
function renderSpell(fresh){
  const main = document.getElementById('main');
  if(fresh || !spellTarget){ spellTarget = pickSpellTarget(); spellChecked = false; }
  if(!spellTarget){
    main.innerHTML = `<div class="emptyMsg">${emptyStateHtml()}</div>`;
    return;
  }
  main.innerHTML = `
    <div class="pearlRow" id="pearlRow" style="justify-content:flex-start;margin-bottom:12px;"></div>
    <div class="qHead">뜻을 보고 영어 스펠링을 입력하세요</div>
    <div class="spellPrompt">
      <div class="ko">${escapeHtml(spellTarget.ko)}</div>
    </div>
    <input type="text" id="spellInput" placeholder="영어 스펠링 입력..." autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false"/>
    <div id="spellFeedback"></div>
    <div class="spellRow">
      <button class="btn ghost" id="spellSkip">모르겠어요</button>
      <button class="btn big" id="spellCheck">정답 확인</button>
    </div>
  `;
  renderPearls();
  const input = document.getElementById('spellInput');
  const feedback = document.getElementById('spellFeedback');
  input.focus();
  function doCheck(){
    if(spellChecked) return;
    spellChecked = true;
    const ok = normalize(input.value) === normalize(spellTarget.en);
    const s = getStat(spellTarget.id, 'spell');
    if(ok){ s.correct++; } else { s.wrong++; }
    saveProgress(progress);
    bumpStreak(ok);
    input.classList.add(ok?'correct':'wrong');
    input.disabled = true;
    feedback.className = ok?'correct':'wrong';
    feedback.textContent = ok ? '정답입니다!' : `정답: ${spellTarget.en}${spellTarget.abbr?' ('+spellTarget.abbr+')':''}`;
    document.getElementById('spellCheck').textContent = '다음 →';
    document.getElementById('spellCheck').onclick = ()=>renderSpell(true);
  }
  document.getElementById('spellCheck').onclick = doCheck;
  document.getElementById('spellSkip').onclick = ()=>{
    if(!spellChecked){
      const s = getStat(spellTarget.id, 'spell'); s.wrong++;
      saveProgress(progress); bumpStreak(false);
    }
    renderSpell(true);
  };
  input.addEventListener('keydown', (e)=>{
    if(e.key==='Enter'){ e.preventDefault(); if(!spellChecked) doCheck(); else renderSpell(true); }
  });
}

// ---------- STATS ----------
let statsMode = localStorage.getItem('customwords_statsmode_v1') || 'flash';
function renderStats(){
  const main = document.getElementById('main');
  const pool = currentTerms();
  const mode = statsMode;

  if(pool.length===0){
    main.innerHTML = `<div class="emptyMsg">${emptyStateHtml()}</div>`;
    return;
  }

  const masteredCount = pool.filter(t=>isMastered(t.id, mode)).length;
  const attempted = pool.filter(t=>{const s=getStat(t.id, mode); return s.correct+s.wrong>0;}).length;
  const missed = pool.map(t=>({t, s:getStat(t.id, mode)}))
    .filter(x=>x.s.wrong>0 && !isMastered(x.t.id, mode))
    .sort((a,b)=> (b.s.wrong-b.s.correct) - (a.s.wrong-a.s.correct)).slice(0,30);

  main.innerHTML = `
    <div id="statsSub" style="display:flex;gap:7px;margin-bottom:16px;"></div>
    <div class="statGrid">
      <div class="statBox"><div class="num">${masteredCount}/${pool.length}</div><div class="lbl">암기 완료 (정답 2회+)</div></div>
      <div class="statBox"><div class="num">${attempted}</div><div class="lbl">학습 시도한 단어 수</div></div>
    </div>
    <div class="qHead">${MODE_LABEL[mode]}에서 자주 틀리는 단어</div>
    <div class="missList" id="missList"></div>
    <button id="resetBtn">이 폴더 학습 기록 초기화</button>
  `;
  const sub = document.getElementById('statsSub');
  MODES.forEach(m=>{
    const chip = document.createElement('div');
    chip.className = 'chip' + (statsMode===m ? ' active':'');
    chip.style.flexShrink = '0';
    chip.textContent = MODE_LABEL[m];
    chip.onclick = ()=>{ statsMode = m; localStorage.setItem('customwords_statsmode_v1', m); renderStats(); };
    sub.appendChild(chip);
  });
  const missList = document.getElementById('missList');
  if(missed.length===0){
    missList.innerHTML = `<div class="emptyMsg">${MODE_LABEL[mode]}에서 아직 틀린 기록이 없어요.</div>`;
  } else {
    missed.forEach(({t,s})=>{
      const row = document.createElement('div');
      row.className = 'missRow';
      row.innerHTML = `<div><div class="en">${escapeHtml(t.en)}${t.abbr?' <span style="color:var(--forest);font-size:11px;">'+escapeHtml(t.abbr)+'</span>':''}</div><div class="ko">${escapeHtml(t.ko)}</div></div><div class="badge">✗${s.wrong}</div>`;
      missList.appendChild(row);
    });
  }
  const resetBtn = document.getElementById('resetBtn');
  let resetArmed = false, resetTimer = null;
  resetBtn.onclick = ()=>{
    if(!resetArmed){
      resetArmed = true;
      resetBtn.textContent = '정말 초기화할까요? 한 번 더 눌러 확인';
      resetBtn.style.background = 'var(--terracotta-tint)';
      clearTimeout(resetTimer);
      resetTimer = setTimeout(()=>{ resetArmed=false; resetBtn.textContent='이 폴더 학습 기록 초기화'; resetBtn.style.background='transparent'; }, 3000);
      return;
    }
    clearTimeout(resetTimer);
    pool.forEach(t=>{ delete progress[t.id]; });
    saveProgress(progress);
    state.streak = 0; localStorage.setItem('customwords_streak_v1','0');
    renderStats();
  };
}

// ---------- MANAGE ----------
function parseDelimited(line){
  const delim = line.indexOf('\t') !== -1 ? '\t' : ',';
  const result = []; let cur=''; let inQuotes=false;
  for(let i=0;i<line.length;i++){
    const ch = line[i];
    if(inQuotes){
      if(ch === '"'){ if(line[i+1]==='"'){ cur+='"'; i++; } else { inQuotes=false; } }
      else cur += ch;
    } else {
      if(ch === '"') inQuotes = true;
      else if(ch === delim){ result.push(cur); cur=''; }
      else cur += ch;
    }
  }
  result.push(cur);
  return result.map(s=>s.trim());
}
function csvEscape(s){
  s = String(s||'');
  if(s.includes(',')||s.includes('"')||s.includes('\n')) return '"'+s.replace(/"/g,'""')+'"';
  return s;
}
function downloadBlob(text, filename){
  const blob = new Blob(['\uFEFF'+text], {type:'text/csv;charset=utf-8;'});
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url; a.download = filename;
  document.body.appendChild(a); a.click(); document.body.removeChild(a);
  setTimeout(()=>URL.revokeObjectURL(url), 1000);
}
function importLines(text){
  if(!currentFolderId) return 0;
  const lines = text.split(/\r\n|\n|\r/).filter(l=>l.trim().length>0);
  if(lines.length===0) return 0;
  let added = 0;
  const startIdx = /^\s*(영어|en|english|term)/i.test(lines[0]) ? 1 : 0;
  lines.slice(startIdx).forEach(line=>{
    const parts = parseDelimited(line);
    const en = (parts[0]||'').trim();
    const abbr = (parts[1]||'').trim();
    const ko = (parts[2]||'').trim();
    if(en && ko){ customTerms.push({id:newId(), folderId: currentFolderId, en, abbr, ko}); added++; }
  });
  if(added>0){ saveTerms(); buildDeck(); }
  return added;
}

function renderFolderList(){
  const wrap = document.getElementById('folderListWrap');
  if(!wrap) return;
  if(folders.length===0){
    wrap.innerHTML = '<div class="emptyMsg" style="padding:20px 4px;">아직 폴더가 없어요. 위에서 폴더를 먼저 만들어보세요.</div>';
    return;
  }
  const list = document.createElement('div');
  list.className = 'folderList';
  folders.forEach(f=>{
    const count = customTerms.filter(t=>t.folderId===f.id).length;
    const row = document.createElement('div');
    row.className = 'folderRow' + (f.id===currentFolderId ? ' active' : '');
    const info = document.createElement('div');
    info.className = 'folderInfo';
    info.innerHTML = `<div class="folderName">${escapeHtml(f.name)}</div><div class="folderCount">${count}개 단어${f.id===currentFolderId?' · 선택됨':''}</div>`;
    info.onclick = ()=>{
      if(currentFolderId===f.id) return;
      currentFolderId = f.id;
      localStorage.setItem(CURRENT_FOLDER_KEY, String(currentFolderId));
      buildDeck();
      renderManage();
      renderFolderChips();
    };
    const actions = document.createElement('div');
    actions.className = 'folderActions';
    const renameBtn = document.createElement('button');
    renameBtn.className = 'iconBtn'; renameBtn.textContent = '✎'; renameBtn.title='이름 변경';
    renameBtn.onclick = (e)=>{ e.stopPropagation(); startRenameFolder(f, info); };
    const delBtn = document.createElement('button');
    delBtn.className = 'iconBtn danger'; delBtn.textContent = '✕'; delBtn.title='삭제';
    delBtn.onclick = (e)=>{
      e.stopPropagation();
      if(delBtn.dataset.armed==='1'){
        deleteFolder(f.id);
      } else {
        delBtn.dataset.armed = '1';
        delBtn.textContent = '정말?';
        setTimeout(()=>{ if(delBtn.isConnected){ delBtn.dataset.armed='0'; delBtn.textContent='✕'; } }, 3000);
      }
    };
    actions.appendChild(renameBtn);
    actions.appendChild(delBtn);
    row.appendChild(info);
    row.appendChild(actions);
    list.appendChild(row);
  });
  wrap.innerHTML = '';
  wrap.appendChild(list);
}
function startRenameFolder(f, infoEl){
  const nameDiv = infoEl.querySelector('.folderName');
  const input = document.createElement('input');
  input.className = 'renameInput';
  input.value = f.name;
  nameDiv.replaceWith(input);
  input.focus();
  input.select();
  let done = false;
  function commit(){
    if(done) return; done = true;
    const v = input.value.trim();
    if(v) f.name = v;
    saveFolders();
    renderManage();
    renderFolderChips();
  }
  input.addEventListener('keydown', e=>{
    if(e.key==='Enter'){ commit(); }
    if(e.key==='Escape'){ done = true; renderManage(); }
  });
  input.addEventListener('blur', commit);
  input.addEventListener('click', e=>e.stopPropagation());
}
function deleteFolder(id){
  const idsToRemove = customTerms.filter(t=>t.folderId===id).map(t=>t.id);
  customTerms = customTerms.filter(t=>t.folderId!==id);
  idsToRemove.forEach(tid=>{ delete progress[tid]; });
  saveProgress(progress);
  folders = folders.filter(f=>f.id!==id);
  saveFolders(); saveTerms();
  if(currentFolderId===id){
    currentFolderId = folders.length>0 ? folders[0].id : null;
    if(currentFolderId) localStorage.setItem(CURRENT_FOLDER_KEY, String(currentFolderId));
    else localStorage.removeItem(CURRENT_FOLDER_KEY);
  }
  buildDeck();
  renderManage();
  renderFolderChips();
}

